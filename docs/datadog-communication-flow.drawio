<mxfile host="app.diagrams.net"><diagram id="flow" name="Telemetry flow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="870" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="g_host" value="Host (laptop / VM)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;arcSize=3;fillColor=#f8fafc;strokeColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="790" height="640" as="geometry"/></mxCell><mxCell id="g_backend" value="Node.js backend :3001" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;arcSize=3;fillColor=#eff6ff;strokeColor=#3b82f6;" vertex="1" parent="1"><mxGeometry x="230" y="100" width="300" height="320" as="geometry"/></mxCell><mxCell id="g_agent" value="Datadog Agent (container)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;arcSize=3;fillColor=#f5f3ff;strokeColor=#632ca6;" vertex="1" parent="1"><mxGeometry x="580" y="100" width="210" height="480" as="geometry"/></mxCell><mxCell id="g_dd" value="Datadog (US1 · datadoghq.com)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;arcSize=3;fillColor=#faf5ff;strokeColor=#632ca6;" vertex="1" parent="1"><mxGeometry x="900" y="160" width="450" height="470" as="geometry"/></mxCell><mxCell id="browser" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;chat UI" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="50" y="120" width="140" height="60" as="geometry"/></mxCell><mxCell id="frontend" value="&lt;b&gt;Frontend&lt;/b&gt;&lt;br&gt;Vue 3 + Vite :5173&lt;br&gt;proxies /api → :3001" style="rounded=1;white