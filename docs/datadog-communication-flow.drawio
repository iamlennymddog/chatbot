eometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="515"/><mxPoint x="850" y="317"/></Array></mxGeometry></mxCell><mxCell id="e11" value="logs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;labelBackgroundColor=#ffffff;strokeColor=#15803d;" edge="1" parent="1" source="a_fwd" target="i_logs"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="870" y="525"/><mxPoint x="870" y="407"/></Array></mxGeometry></mxCell><mxCell id="e12" value="⑥ HTTPS 443 · OTLP/protobuf · dd-api-key — direct, not via the Agent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;labelBackgroundColor=#ffffff;strokeColor=#7c3aed;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="otel" target="i_otlp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="680"/><mxPoint x="1005" y="680"/></Array></mxGeometry></mxCell><mxCell id="p0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;labelBackgroundColor=#ffffff;strokeColor=#1f6fd1;" edge="1" parent="1" source="i_trace" target="p_apm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;labelBackgroundColor=#ffffff;strokeColor=#d97706;" edge="1" parent="1" source="i_metrics" target="p_metrics"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;labelBackgroundColor=#ffffff;strokeColor=#15803d;" edge="1" parent="1" source="i_logs" target="p_logs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=2;labelBackgroundColor=#ffffff;strokeColor=#7c3aed;" edge="1" parent="1" source="i_otlp" target="p_llm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x2" value="same trace ID · View in APM" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;dashed=1;endArrow=block;startArrow=block;endFill=1;startFill=1;strokeColor=#7c3aed;exitX=1;exitY=0.5;entryX=1;entryY=0.25;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p_llm" target="p_apm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1325" y="547"/><mxPoint x="1325" y="214"/></Array></mxGeometry></mxCell><mxCell id="x1" value="trace_id" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;dashed=1;endArrow=none;strokeColor=#94a3b8;exitX=1;exitY=0.5;entryX=1;entryY=0.75;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p_logs" target="p_apm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1298" y="407"/><mxPoint x="1298" y="241"/></Array></mxGeometry></mxCell><mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#a78bfa;" edge="1" parent="1" source="a_apm" target="a_fwd"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="785" y="167"/><mxPoint x="785" y="520"/></Array></mxGeometry></mxCell><mxCell id="a2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#a78bfa;" edge="1" parent="1" source="a_dsd" target="a_fwd"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="785" y="252"/><mxPoint x="785" y="520"/></Array></mxGeometry></mxCell><mxCell id="a3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#a78bfa;" edge="1" parent="1" source="a_logs" target="a_fwd"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="785" y="337"/><mxPoint x="785" y="520"/></Array></mxGeometry></mxCell><mxCell id="a4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#a78bfa;" edge="1" parent="1" source="a_checks" target="a_fwd"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="785" y="422"/><mxPoint x="785" y="520"/></Array></mxGeometry></mxCell><mxCell id="title" value="&lt;b&gt;BitsTalk Deal Buddy → Datadog: telemetry flow&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="790" height="40" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color='#1f6fd1'&gt;■&lt;/font&gt; APM traces (dd-trace → Agent)&lt;br&gt;&lt;font color='#d97706'&gt;■&lt;/font&gt; Metrics (DogStatsD, Agent checks)&lt;br&gt;&lt;font color='#15803d'&gt;■&lt;/font&gt; Logs (file → Agent)&lt;br&gt;&lt;font color='#7c3aed'&gt;■&lt;/font&gt; LLM Observability (OpenTelemetry → OTLP intake, bypasses the Agent)&lt;br&gt;&lt;font color='#c2410c'&gt;■&lt;/font&gt; LLM calls (not telemetry)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fontSize=12;fillColor=#ffffff;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="20" y="720" width="520" height="120" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Why two paths?&lt;/b&gt; The LLM Observability Execution Graph is built from span links, which the dd-trace Node.js LLM Obs SDK can't emit. Agent/LLM/tool spans therefore go via OpenTelemetry straight to Datadog's OTLP intake; dd-trace keeps APM, runtime metrics and log correlation through the local Agent. &lt;br&gt;&lt;b&gt;One trace ID:&lt;/b&gt; OpenTelemetry reuses the dd-trace trace ID of each request (DatadogTraceIdGenerator), so an LLM Observability trace opens in APM (View in APM) and shows the request's correlated logs." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingRight=12;fontSize=12;fillColor=#faf5ff;strokeColor=#c4b5fd;" vertex="1" parent="1"><mxGeometry x="560" y="720" width="790" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>